# ==========================================
# HackCC Project Environment Variables (.env)
# ==========================================
# INSTRUCTIONS:
# 1. Duplicate this file and rename it to `.env`
# 2. Never commit `.env` to GitHub! Keep it in .gitignore.
# 3. In Vite, all client-side variables must start with `VITE_`
# 4. Access in React code via: `import.meta.env.VITE_YOUR_VARIABLE`

# App Metadata
VITE_APP_TITLE="HackCC 2026 Project"
VITE_HACKATHON_END_TIME="2026-11-22T17:00:00"

# Optional: AI Model API Keys (Gemini / OpenAI / Anthropic)
# NOTE: For public hackathon demos, consider proxying via a lightweight backend or Supabase Edge Function!
VITE_GEMINI_API_KEY=""
VITE_OPENAI_API_KEY=""

# Optional: Backend / Database (e.g. Supabase, Firebase)
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
